#ifndef VERSION_H_IN
#define VERSION_H_IN

#define STRAWBERRY_VERSION_DISPLAY "${STRAWBERRY_VERSION_DISPLAY}"
#define STRAWBERRY_VERSION_PACKAGE "${STRAWBERRY_VERSION_PACKAGE}"

// Akousma's own version (cmake/AkousmaVersion.cmake). AKOUSMA_VERSION is always the plain release version ("1.0.0");
// AKOUSMA_VERSION_DISPLAY adds the git commit when built with AKOUSMA_INCLUDE_GIT_COMMIT=ON ("1.0.0 (git abc1234)").
#define AKOUSMA_VERSION "${AKOUSMA_VERSION}"
#define AKOUSMA_VERSION_DISPLAY "${AKOUSMA_VERSION_DISPLAY}"
#define AKOUSMA_VERSION_PACKAGE "${AKOUSMA_VERSION_PACKAGE}"
#define AKOUSMA_GIT_COMMIT "${AKOUSMA_GIT_COMMIT_SHORT}"
#define AKOUSMA_BASE_STRAWBERRY_VERSION "${AKOUSMA_BASE_STRAWBERRY_VERSION}"
#define AKOUSMA_BASE_STRAWBERRY_COMMIT "${AKOUSMA_BASE_STRAWBERRY_COMMIT}"

#endif  // VERSION_H_IN
