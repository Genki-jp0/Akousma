akousma ICON "${CMAKE_SOURCE_DIR}/dist/windows/akousma.ico"
1 VERSIONINFO
FILEVERSION     ${AKOUSMA_VERSION_MAJOR},${AKOUSMA_VERSION_MINOR},${AKOUSMA_VERSION_PATCH},0
PRODUCTVERSION  ${AKOUSMA_VERSION_MAJOR},${AKOUSMA_VERSION_MINOR},${AKOUSMA_VERSION_PATCH},0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "080904E4"
    BEGIN
      VALUE "CompanyName", "Genki (genki_jp0)"
      VALUE "FileDescription", "Akousma"
      VALUE "FileVersion", "${AKOUSMA_VERSION_DISPLAY}"
      VALUE "InternalName", "akousma"
      VALUE "OriginalFilename", "akousma.exe"
      VALUE "ProductName", "Akousma"
      VALUE "ProductVersion", "${AKOUSMA_VERSION_DISPLAY}"
    END
  END

  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0809, 1252
  END
END
