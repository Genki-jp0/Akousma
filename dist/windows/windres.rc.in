akousma ICON "${CMAKE_SOURCE_DIR}/dist/windows/akousma.ico"
// The other styles of the application icon, to choose for a shortcut. The first icon above is the program's icon.
akousma_win10 ICON "${CMAKE_SOURCE_DIR}/data/icons/akousma/akousma-win10.ico"
akousma_win81 ICON "${CMAKE_SOURCE_DIR}/data/icons/akousma/akousma-win81-desktop.ico"
akousma_win8 ICON "${CMAKE_SOURCE_DIR}/data/icons/akousma/akousma-win8-tile.ico"
akousma_aero ICON "${CMAKE_SOURCE_DIR}/data/icons/akousma/akousma-aero.ico"
1 VERSIONINFO
FILEVERSION     ${AKOUSMA_VERSION_MAJOR},${AKOUSMA_VERSION_MINOR},${AKOUSMA_VERSION_PATCH},0
PRODUCTVERSION  ${AKOUSMA_VERSION_MAJOR},${AKOUSMA_VERSION_MINOR},${AKOUSMA_VERSION_PATCH},0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "080904E4"
    BEGIN
      VALUE "CompanyName", "Genki (genki_jp0)"
      VALUE "FileDescription", "Akousma"
      VALUE "FileVersion", "${AKOUSMA_VERSION_DISPLAY}"
      VALUE "InternalName", "akousma"
      VALUE "OriginalFilename", "akousma.exe"
      VALUE "ProductName", "Akousma"
      VALUE "ProductVersion", "${AKOUSMA_VERSION_DISPLAY}"
    END
  END

  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0809, 1252
  END
END
